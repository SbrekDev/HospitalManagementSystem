<Application x:Class="SanatorioHMS.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SanatorioHMS.Desktop"
             xmlns:vm="clr-namespace:SanatorioHMS.Desktop.ViewModels">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Navigation stores view models in ShellViewModel.CurrentView.
                 These templates resolve each view model to its corresponding view. -->
            <DataTemplate DataType="{x:Type vm:PatientSearchViewModel}">
                <local:PatientSearchView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PatientRegistrationViewModel}">
                <local:PatientRegistrationView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AgendaGridViewModel}">
                <local:AgendaGridView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
