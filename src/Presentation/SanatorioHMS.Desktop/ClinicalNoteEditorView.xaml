<UserControl x:Class="SanatorioHMS.Desktop.ClinicalNoteEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel Margin="20"><TextBlock Text="Nota clínica" FontSize="22"/><ComboBox SelectedValue="{Binding NoteType}" Margin="0,12"><ComboBoxItem Content="Evolución"/><ComboBoxItem Content="Procedimiento"/></ComboBox><TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="140"/><Button Content="Agregar nota" Command="{Binding SaveCommand}" Margin="0,12" IsEnabled="{Binding CanEdit}"/><TextBlock Text="{Binding ErrorMessage}" Foreground="DarkRed"/></StackPanel></UserControl>
