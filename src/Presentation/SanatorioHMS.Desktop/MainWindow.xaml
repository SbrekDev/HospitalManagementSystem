    <ContentControl Content="{Binding}">
        <ContentControl.Resources>
            <DataTemplate DataType="{x:Type vm:LoginViewModel}"><local:LoginView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ShellViewModel}"><local:ShellView/></DataTemplate>
        </ContentControl.Resources>
    </ContentControl>
</Window>
