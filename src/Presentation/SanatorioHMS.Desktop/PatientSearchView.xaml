<UserControl x:Class="SanatorioHMS.Desktop.PatientSearchView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><DockPanel Margin="16"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><TextBox Width="300" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Buscar" Command="{Binding SearchCommand}"/></StackPanel><DataGrid ItemsSource="{Binding Results}" AutoGenerateColumns="True" IsReadOnly="True"/><TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Foreground="Red"/></DockPanel></UserControl>
